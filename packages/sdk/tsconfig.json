{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // noEmit matches the runtime shape used by the existing workspace packages:
    // Node strips the TypeScript source directly during tests.
    "noEmit": true,
    // Relative imports carry an explicit .ts extension so Node's type
    // stripping can resolve them without a build step.
    "allowImportingTsExtensions": true,
    // Decision 6a: reject at typecheck time the syntax Node cannot strip,
    // rather than letting node --test fail at load.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src"]
}
