{
  // Deliberately standalone rather than extending tsconfig.base.json.
  //
  // The Vercel Node builder compiles the functions in this directory with this
  // exact file, so it has to describe a real emit. The base config sets
  // noEmitOnError, module esnext and a workspace resolution condition, all of
  // which are right for the bundled packages and wrong here: the repository
  // root has no "type": "module", so these functions are emitted and loaded as
  // CommonJS.
  //
  // `pnpm run typecheck` runs a real emit into .tsc-api-emit and then asserts
  // its layout, because the failure below exits 0. Nothing here turns emit off.
  //
  // rootDir is pinned to this directory. Without it TypeScript infers the emit
  // root from the common source directory of the program, so one relative
  // import out of api/ raises the root to the repository root and every
  // compiled function moves from <out>/registry.js to <out>/api/registry.js at
  // once, which Vercel cannot resolve for any route, with zero diagnostics.
  // Pinned, that becomes error TS6059 naming the offending file.
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
