# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Scratch output from the api function emit check
.tsc-api-emit

# graphify knowledge graph output: regenerable, contains the forbidden dash
# characters in generated prose, and never ships
graphify-out/

# A violating emit under api/ writes .js next to its TypeScript source here.
# api/tsconfig.json deliberately does not set noEmitOnError, so keep the stray
# output out of git rather than committing it. Scoped to src/ on purpose: a
# blanket packages/**/*.js would also swallow a committed bin entry point, and
# git would refuse it without -f while git status stayed silent about why.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
.vercel
.env*
/.swc

/.nitro
