{
  "name": "@void/workspace",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "tui:preview": "pnpm --filter @void/cli run tui:preview --",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter \"./scripts\" --if-present run typecheck && tsc -p apps/control-plane/tsconfig.json",
    "test": "node scripts/src/check-tests.mjs",
    "check": "pnpm run typecheck && pnpm test",
    "check:mirror": "node scripts/src/check-registry-mirror.mjs",
    "gui": "node apps/control-plane/api/server.ts",
    "watch": "node packages/cli/bin/void.mjs watch"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "description": "VOID development workspace for accountable AI tool calls, signed ledgers, and guarded replay.",
  "bin": {
    "void": "packages/cli/bin/void.mjs",
    "void-proxy": "packages/proxy/bin/void-proxy.mjs"
  },
  "keywords": [
    "void",
    "mcp",
    "ai-safety",
    "audit",
    "reversibility"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/oidc": "^3.8.7",
    "express": "^5.2.1",
    "nitro": "3.0.260903-beta",
    "rollup": "^4.63.1",
    "workflow": "^4.8.8"
  }
}
